POSTGRES_USER=timesheet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=timesheet
APP_PORT=8787
# путь к OAuth-токену Яндекс Трекера для синхронизации зеркала (ro-маунт, режим 0600)
# TRACKER_TOKEN_HOST_FILE=/home/USER/.config/yandex-tracker/token
# организация Яндекс Трекера (заголовок X-Org-ID)
# TRACKER_ORG_ID=0000000
# DNS-сервер, если встроенный DNS docker не резолвит внешние имена (например, шлюз сети)
# DNS_SERVER=192.168.0.1
# путь к локальному списку проектов табеля (см. README, «Быстрый старт»)
# PROJECTS_FILE=/abs/path/to/projects.json
